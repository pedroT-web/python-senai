    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <output expression="&quot;================ Quadrado e Cubo de um n&#250;mero ================&quot;" newline="True"/>
            <declare name="numero, quadrado, cubo" type="Real" array="False" size=""/>
            <output expression="&quot;Digite o n&#250;mero desejado: &quot;" newline="True"/>
            <input variable="numero"/>
            <assign variable="quadrado" expression="numero^2"/>
            <assign variable="cubo" expression="numero ^ 3"/>
            <output expression="&quot;O quadrado do n&#250;mero &quot; &amp; numero &amp; &quot; &#233;: &quot; &amp; quadrado &amp; &quot; e o cubo dele &#233;: &quot; &amp; cubo" newline="True"/>
        </body>
    </function>
</flowgorithm>
