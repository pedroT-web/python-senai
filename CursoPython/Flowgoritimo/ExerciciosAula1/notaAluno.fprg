<flowgorithm fileversion="4.0">
    <attributes>
        <attribute name="name" value=""/>
        <attribute name="authors" value="Aluno"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-08-01 05:04:48 "/>
        <attribute name="created" value="QWx1bm87RUNGUDUxMk4xMjYyODM3OzIwMjYtMDgtMDE7IjA0OjU5OjI4ICI7MjU5NA=="/>
        <attribute name="edited" value="QWx1bm87RUNGUDUxMk4xMjYyODM3OzIwMjYtMDgtMDE7IjA1OjA0OjQ4ICI7MTsyNjk1"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <output expression="&quot;==================== M&#233;dia Aluno ====================&quot;" newline="True"/>
            <declare name="notaProva, notaTrabalho, media" type="Real" array="False" size=""/>
            <declare name="nomeAluno" type="String" array="False" size=""/>
            <output expression="&quot;Digite o nome do aluno: &quot;" newline="True"/>
            <input variable="nomeAluno"/>
            <output expression="&quot;Digite a nota da prova dele: &quot;" newline="True"/>
            <input variable="notaProva"/>
            <output expression="&quot;Digite a nota do trabalho dele: &quot;" newline="True"/>
            <input variable="notaTrabalho"/>
            <assign variable="media" expression="((notaProva * 2) + notaTrabalho)/3"/>
            <output expression="&quot;A m&#233;dia final do aluno &quot; &amp; nomeAluno &amp; &quot; &#233; de: &quot; &amp; media &amp; &quot; pontos&quot;" newline="True"/>
        </body>
    </function>
</flowgorithm>
