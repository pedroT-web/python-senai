<flowgorithm fileversion="4.0">
    <attributes>
        <attribute name="name" value=""/>
        <attribute name="authors" value="Aluno"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-08-01 04:59:24 "/>
        <attribute name="created" value="QWx1bm87RUNGUDUxMk4xMjYyODM3OzIwMjYtMDgtMDE7IjA0OjU0OjQ1ICI7MjU4OA=="/>
        <attribute name="edited" value="QWx1bm87RUNGUDUxMk4xMjYyODM3OzIwMjYtMDgtMDE7IjA0OjU5OjI0ICI7MTsyNjk4"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <output expression="&quot;====================== Companhia de Carros ======================&quot;" newline="True"/>
            <declare name="carrosVendidos, valorTotal, comissao, porcentagemVendas, salarioFinal" type="Integer" array="False" size=""/>
            <output expression="&quot;Digite a quantidade de carros vendidos este m&#234;s: &quot;" newline="True"/>
            <input variable="carrosVendidos"/>
            <output expression="&quot;Digite o valor total das vendas desses carros: &quot;" newline="True"/>
            <input variable="valorTotal"/>
            <assign variable="comissao" expression="carrosVendidos * 500"/>
            <assign variable="porcentagemVendas" expression="valorTotal * 0.01"/>
            <assign variable="salarioFinal" expression="2000 + comissao + porcentagemVendas"/>
            <output expression="&quot;O sal&#225;rio final &#233; de: R$&quot; &amp; salarioFinal" newline="True"/>
        </body>
    </function>
</flowgorithm>
