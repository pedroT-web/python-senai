    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="celcius, farenheit" type="Real" array="False" size=""/>
            <output expression="&quot;================ Convers&#227;o de Celcius para Farenheit ================&quot;" newline="True"/>
            <output expression="&quot;Digite a temperatura atual de celcius para convers&#227;o: &quot;" newline="True"/>
            <input variable="celcius"/>
            <assign variable="farenheit" expression="(9/5)*celcius + 32"/>
            <output expression="celcius &amp; &quot;&#176; graus celcius &#233; igual a &quot; &amp; farenheit &amp; &quot; Farenheit&quot;" newline="True"/>
        </body>
    </function>
