    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <output expression="&quot;===================== Quantidade de chuva =====================&quot;" newline="True"/>
            <declare name="chuvaPolegada, chuvaMm" type="Real" array="False" size=""/>
            <output expression="&quot;Escreva a quantidade de chuva em polegada: &quot;" newline="True"/>
            <input variable="chuvaPolegada"/>
            <assign variable="chuvaMm" expression="chuvaPolegada * 25.4"/>
            <output expression="&quot;A quantidade de chuva em &quot; &amp; chuvaPolegada &amp; &quot; polegadas equivale a uma chuva de &quot; &amp; chuvaMm &amp; &quot;mm&quot;" newline="True"/>
        </body>
    </function>
</flowgorithm>
